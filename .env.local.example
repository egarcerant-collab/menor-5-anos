# Sincronización automática con la carpeta de Google Drive (opcional).
# Sin estas variables, el dashboard sigue funcionando con carga manual de Excel.
#
# 1. Crear una cuenta de servicio en Google Cloud Console con la API de Drive habilitada.
# 2. Compartir la carpeta de Drive con el email de la cuenta de servicio (permiso "Lector").
# 3. Copiar el email y la clave privada del JSON generado aquí abajo.
# 4. En producción (Vercel): agregar estas mismas variables en
#    Project Settings -> Environment Variables (NUNCA committear valores reales).

GOOGLE_DRIVE_CLIENT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nAAAA...\n-----END PRIVATE KEY-----\n"

# Opcional: solo si se quiere apuntar a otra carpeta distinta a la de Dusakawi EPS.
# DRIVE_FOLDER_ID=12wtavmNU_CKeHT2Xy1Nn08oXCwzttfkB
